<!-- Explicit manual layout format. Coordinates use a 1280 x 720 canvas. -->
<!ELEMENT presentation (style?, slide+)>
<!ATTLIST presentation name CDATA #IMPLIED style CDATA #IMPLIED>
<!--
  Presenter Style DTD
  ===================
  Standalone style files referenced via <presentation style="..."> or the CLI style option.
  All attributes are optional — omitted values keep the built-in default.

  Example usage:
    <presentation style="./styles/dark.style">
    or
    presenter demo.slides [style option] styles/light.style
-->

<!ELEMENT style (fonts?, colors?, charts?, syntax?, layout?)>
<!ATTLIST style theme CDATA #IMPLIED name CDATA #IMPLIED>

<!ELEMENT fonts EMPTY>
<!ATTLIST fonts
    titleFamily CDATA #IMPLIED
    bodyFamily CDATA #IMPLIED
    codeFamily CDATA #IMPLIED
    childTitle CDATA #IMPLIED
    boldTitles (true|false) #IMPLIED
    title    CDATA #IMPLIED
    subtitle CDATA #IMPLIED
    content  CDATA #IMPLIED
    bullet   CDATA #IMPLIED
    small    CDATA #IMPLIED>

<!ELEMENT colors EMPTY>
<!ATTLIST colors
    bg       CDATA #IMPLIED
    bg2      CDATA #IMPLIED
    text     CDATA #IMPLIED
    title    CDATA #IMPLIED
    subtitle CDATA #IMPLIED
    accent   CDATA #IMPLIED
    dim      CDATA #IMPLIED
    presenterNext CDATA #IMPLIED
    line     CDATA #IMPLIED>

<!ELEMENT charts EMPTY>
<!ATTLIST charts
    series1 CDATA #IMPLIED
    series2 CDATA #IMPLIED
    series3 CDATA #IMPLIED
    series4 CDATA #IMPLIED
    series5 CDATA #IMPLIED
    series6 CDATA #IMPLIED
    grid    CDATA #IMPLIED
    label   CDATA #IMPLIED>

<!ELEMENT layout EMPTY>
<!ELEMENT syntax EMPTY>
<!ATTLIST syntax
    bg CDATA #IMPLIED
    border CDATA #IMPLIED
    text CDATA #IMPLIED
    keyword CDATA #IMPLIED
    type CDATA #IMPLIED
    string CDATA #IMPLIED
    comment CDATA #IMPLIED
    number CDATA #IMPLIED
    builtin CDATA #IMPLIED
    punctuation CDATA #IMPLIED>
<!ATTLIST layout
    margin          CDATA #IMPLIED
    padding         CDATA #IMPLIED
    gap             CDATA #IMPLIED
    columnGap       CDATA #IMPLIED
    linePadding     CDATA #IMPLIED
    presenterMargin CDATA #IMPLIED
    cornerRadius    CDATA #IMPLIED
    imageCornerRadius CDATA #IMPLIED
    presenterCornerRadius CDATA #IMPLIED
    bulletGap       CDATA #IMPLIED>

<!ENTITY % box 'width CDATA #IMPLIED height CDATA #IMPLIED
minWidth CDATA #IMPLIED minHeight CDATA #IMPLIED
maxWidth CDATA #IMPLIED maxHeight CDATA #IMPLIED
margin CDATA #IMPLIED
horizontalAlignment (stretch|start|center|end) "stretch"
verticalAlignment (stretch|start|center|end) "stretch"
row CDATA "0" column CDATA "0" rowSpan CDATA "1" columnSpan CDATA "1"'>
<!ENTITY % visual "(stack|grid|border|text|image|code|chart|icon)">
<!ELEMENT slide (notes?, (stack|grid|border))>
<!ATTLIST slide title CDATA #IMPLIED>
<!ELEMENT notes (#PCDATA)>
<!ELEMENT stack (%visual;)*>
<!ATTLIST stack %box; orientation (vertical|horizontal) "vertical" gap CDATA "0">
<!ELEMENT grid (%visual;)*>
<!ATTLIST grid %box; rows CDATA "*" columns CDATA "*" gap CDATA "0">
<!ELEMENT border %visual;>
<!ATTLIST border %box; padding CDATA "0" background CDATA #IMPLIED borderColor CDATA #IMPLIED cornerRadius CDATA "0">
<!ELEMENT text (#PCDATA|b|i|code)*>
<!ATTLIST text %box; role (title|subtitle|heading|body|small) "body" color CDATA #IMPLIED wrap (true|false) "true" textAlignment (start|center|end|stretch) "start">
<!ELEMENT b (#PCDATA|b|i|code)*>
<!ELEMENT i (#PCDATA|b|i|code)*>
<!ELEMENT code (#PCDATA)>
<!ATTLIST code %box; lang CDATA #IMPLIED>
<!ELEMENT image EMPTY>
<!ATTLIST image %box; src CDATA #REQUIRED alt CDATA #IMPLIED fit (fit|fill) "fit">
<!ELEMENT icon (#PCDATA|b|i|code)*>
<!ATTLIST icon %box; name CDATA #IMPLIED>
<!ELEMENT chart (point*)>
<!ATTLIST chart %box; type (bar|line|pie|donut) "bar" title CDATA #IMPLIED icon CDATA #IMPLIED showValues (true|false) "true">
<!ELEMENT point EMPTY>
<!ATTLIST point label CDATA #IMPLIED value CDATA #REQUIRED>
